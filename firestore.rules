rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email']) &&
        data.id == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    // Payroll settings validation
    function isValidPayrollSettings(data, userId) {
      return data.keys().hasAll(['userId']) &&
        data.userId == userId &&
        data.userId is string &&
        data.userId.size() <= 128 &&
        (!('baseSalary' in data) || data.baseSalary is number) &&
        (!('appName' in data) || (data.appName is string && data.appName.size() <= 100)) &&
        (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 100)) &&
        (!('workStartDate' in data) || (data.workStartDate is string && data.workStartDate.size() <= 10));
    }

    // Cycle data validation
    function isValidCycleData(data, userId) {
      return data.keys().hasAll(['userId', 'cycleKey']) &&
        data.userId == userId &&
        data.cycleKey is string &&
        data.cycleKey.size() <= 10 &&
        (!('taxPaid' in data) || data.taxPaid is number) &&
        (!('records' in data) || (data.records is list && data.records.size() <= 40));
    }

    // Holiday validation
    function isValidHoliday(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'date', 'name']) &&
        data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.date is string &&
        data.date.size() <= 10 &&
        data.name is string &&
        data.name.size() <= 100;
    }

    // Salary increment validation
    function isValidSalaryIncrement(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'tenureYear', 'effectiveMonth', 'salaryAfter']) &&
        data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.tenureYear is number &&
        data.effectiveMonth is string &&
        data.effectiveMonth.size() <= 10 &&
        data.salaryAfter is number;
    }

    // Pay slip attachment validation
    function isValidPaySlip(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'cycleKey', 'payPeriodLabel', 'imageDataUrl', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'cycleKey', 'payPeriodLabel', 'imageDataUrl', 'createdAt',
          'updatedAt', 'fileName', 'mimeType', 'fileSizeBytes', 'downloadCount', 'lastDownloadedAt',
          'paymentDate', 'bankName', 'netAmount', 'grossIncome', 'totalDeductions', 'earnings', 'deductions', 'ocrExtracted', 'note'
        ]) &&
        data.userId == userId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.cycleKey is string &&
        data.cycleKey.size() >= 6 &&
        data.cycleKey.size() <= 10 &&
        data.payPeriodLabel is string &&
        data.payPeriodLabel.size() > 0 &&
        data.payPeriodLabel.size() <= 120 &&
        data.imageDataUrl is string &&
        data.imageDataUrl.size() > 0 &&
        data.imageDataUrl.size() <= 850000 &&
        data.createdAt is string &&
        data.createdAt.size() > 0 &&
        data.createdAt.size() <= 40 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 150)) &&
        (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 50)) &&
        (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0)) &&
        (!('downloadCount' in data) || (data.downloadCount is number && data.downloadCount >= 0)) &&
        (!('lastDownloadedAt' in data) || (data.lastDownloadedAt is string && data.lastDownloadedAt.size() <= 40)) &&
        (!('paymentDate' in data) || (data.paymentDate is string && data.paymentDate.size() <= 10)) &&
        (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 80)) &&
        (!('netAmount' in data) || (data.netAmount is number && data.netAmount >= 0)) &&
        (!('grossIncome' in data) || (data.grossIncome is number && data.grossIncome >= 0)) &&
        (!('totalDeductions' in data) || (data.totalDeductions is number && data.totalDeductions >= 0)) &&
        (!('earnings' in data) || data.earnings is map) &&
        (!('deductions' in data) || data.deductions is map) &&
        (!('ocrExtracted' in data) || data.ocrExtracted is bool) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // User document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Payroll Settings subcollection
      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingId) && isValidPayrollSettings(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(settingId) && isValidPayrollSettings(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      // User Cycles subcollection
      match /cycles/{cycleKey} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cycleKey) && isValidCycleData(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(cycleKey) && isValidCycleData(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(cycleKey);
      }

      // User Holidays subcollection
      match /holidays/{holidayId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(holidayId) && isValidHoliday(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(holidayId) && isValidHoliday(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(holidayId);
      }

      // User Salary Increments subcollection
      match /salaryIncrements/{incrementId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(incrementId) && isValidSalaryIncrement(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(incrementId) && isValidSalaryIncrement(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(incrementId);
      }

      // User Pay Slips subcollection
      match /paySlips/{slipId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(slipId) && isValidPaySlip(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(slipId) && isValidPaySlip(incoming(), userId) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(slipId);
      }
    }
  }
}
